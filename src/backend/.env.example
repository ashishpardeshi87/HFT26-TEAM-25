# SENTINEL APEX local deployment configuration — placeholders only.
# Never commit .env. Setup target credentials are request-scoped and are NOT stored here.

# Optional Featherless evidence summarizer. Deterministic facts remain authoritative.
FEATHERLESS_API_KEY=
FEATHERLESS_MODEL=Qwen/Qwen2.5-Coder-32B-Instruct
FEATHERLESS_API_BASE=https://api.featherless.ai/v1

# Organization AI-provider allowlist (comma-separated exact hosts).
ORG_ALLOWLIST=

# Required for stable cross-event secret fingerprints. Generate a random 32+ byte value.
ORG_HMAC_KEY=
# Optional deployment-unique canary. Do not use the old/public fixture value.
SENTINEL_CANARY=

# Durable local state/evidence locations (defaults to src/backend/.sentinel/).
SENTINEL_STATE_PATH=
SENTINEL_DATA_DIR=
# Optional evidence-record HMAC key; keep separate from monitored-agent credentials.
SENTINEL_EVIDENCE_HMAC_KEY=
# Stable key for short-lived signed execution capabilities; generate 32+ random bytes.
SENTINEL_EXECUTION_HMAC_KEY=
# Optional off-box append-only checkpoint endpoint and scoped token.
SENTINEL_ANCHOR_URL=
SENTINEL_ANCHOR_TOKEN=
SENTINEL_ANCHOR_EVERY=25

# URL health check interval after verified setup.
SENTINEL_TARGET_POLL_SECONDS=30
# Gateway/sensor credential lifetime for multi-day monitoring (7 days; max 604800).
SENTINEL_GATEWAY_TOKEN_TTL=604800
SENTINEL_CORS_ORIGINS=http://127.0.0.1:4173,http://localhost:4173
# Keep false in real use; opt in only for an isolated local test target.
SENTINEL_ALLOW_LOOPBACK_TARGETS=false

# DarkGuard live server-to-server bridge. No synthetic fallback exists.
DARKGUARD_ENABLED=false
DARKGUARD_API_BASE=http://127.0.0.1:8080/api
# Option A: approved short-lived/local-session token
DARKGUARD_TOKEN=
# Option B: dedicated least-privilege integration account (kept server-side)
DARKGUARD_EMAIL=
DARKGUARD_PASSWORD=
DARKGUARD_SCAN_TIMEOUT=180
# Optional but recommended: lets SENTINEL distinguish candidates from Tor-ready collection.
DARKGUARD_SCRAPER_HEALTH_URL=http://127.0.0.1:9000/health

# Tor Finder (onion browser) proxies directly to the DarkGuard scraper's /tor/*
# endpoints, independent of DARKGUARD_ENABLED. Defaults match a local scraper.
DARKGUARD_SCRAPER_URL=http://127.0.0.1:9000
DARKGUARD_SCRAPER_TOKEN=dev-scraper-token

# Optional OWASP ZAP integration. Active scans remain disabled unless the target
# is separately authorized; passive OSINT never fabricates a ZAP result.
ZAP_API_URL=
ZAP_API_KEY=
ZAP_ACTIVE_SCAN_AUTHORIZED=false
